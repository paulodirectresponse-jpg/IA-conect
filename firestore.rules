rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IA Connect data is server-authoritative.
    // Browser clients authenticate with Firebase Auth, but all application data
    // is read/written through the IA Connect API using service-account REST.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
