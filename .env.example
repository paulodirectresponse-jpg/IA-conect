# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# INITIAL_ADMIN_EMAIL: (Optional) Initial admin email automatically assigned ADMIN role upon registration.
INITIAL_ADMIN_EMAIL=""

# ADMIN_BOOTSTRAP_SECRET: (Optional) Technical secret for server-level initial bootstrap if needed (NOT a user login password).
ADMIN_BOOTSTRAP_SECRET=""

# ATLAS_API_KEY: (Optional) API Key for Atlas Cloud video compute provider.
ATLAS_API_KEY=""
ATLAS_BASE_URL="https://api.atlascloud.ai/v1"

# WAVESPEED_API_KEY: (Optional) API Key for WaveSpeed AI video compute provider.
WAVESPEED_API_KEY=""
WAVESPEED_BASE_URL="https://api.wavespeed.ai/v1"

# PAYMENT_GATEWAY_API_KEY: (Optional) Credentials for PIX/Card payment gateway.
PAYMENT_GATEWAY_API_KEY=""

